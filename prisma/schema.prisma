generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id @default(cuid())
  telegramId String  @unique
  name       String?
  username   String? @unique
  image      String?
  role       Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("users")
}

model RoleChangeLog {
  id             String   @id @default(cuid())
  targetId       String
  targetUsername String?
  changedById    String
  fromRole       Role
  toRole         Role
  createdAt      DateTime @default(now())

  @@map("role_change_logs")
}

model RateLimitAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("rate_limit_attempts")
}

enum Role {
  USER
  ADMIN
}